# ==============================================================================
# Ferrovia Circumetnea (FCE) Bot - Environment Configuration
# ==============================================================================

# Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel ID or @public_handle for broadcasting service announcements (Optional)
# e.g., @circumetnea_avvisi or -1001234567890
TELEGRAM_CHANNEL_ID=

# Admin Telegram User IDs (comma-separated, get your ID with /chat_id command in the bot)
ADMIN_USER_IDS=

# ==============================================================================
# AI Travel Assistant Configuration (Google Gemini)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ==============================================================================
# Payments & AI Subscription (Zero developer cost, Stripe or Telegram Stars)
# ==============================================================================
# Payment Provider Token from @BotFather -> Payments (e.g. Stripe test/live token)
# Leave empty to charge natively via Telegram Stars (XTR) with 0 setup cost!
PAYMENT_PROVIDER_TOKEN=
AI_SUBSCRIPTION_PRICE_EUR=1.00
AI_SUBSCRIPTION_DAYS=30
AI_TRIAL_DAYS=1
AI_TRIAL_ENABLED=true
AI_CURRENCY=EUR

# ==============================================================================
# Vercel, Webhook & Persistent Database (Neon / Vercel Postgres)
# ==============================================================================
# On Vercel Serverless, /tmp is ephemeral and resets when containers scale down.
# Connect a free Neon / Vercel Postgres database in Vercel Dashboard -> Storage
# (which automatically sets POSTGRES_URL / DATABASE_URL) to persist users & news_cache permanently.
# Locally or in Docker, leave empty to automatically use SQLite (fce_lines.db).
# POSTGRES_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=
# WEBHOOK_URL=https://your-project.vercel.app/api/webhook
# WEBHOOK_SECRET=your_random_secret_token_here
# CRON_SECRET=your_cron_secret_token_here
